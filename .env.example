# URL privada de FastAPI visible desde los contenedores Docker.
# Pueden ser iguales cuando FastAPI está publicado en la IP del host.
BACKEND_INTERNAL_URL=http://host.docker.internal:9000
BACKEND_UPSTREAM=host.docker.internal:9000

# En producción es PREFERIBLE conectar ambos stacks a la misma red Docker
# y usar BACKEND_INTERNAL_URL=http://backend:9000, BACKEND_UPSTREAM=backend:9000
# si el servicio API tiene alias 'backend'.
